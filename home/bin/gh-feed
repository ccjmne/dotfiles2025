#!/bin/sh -eu

enrich() {
  while IFS= read -r notification; do
    url=$(printf '%s\n' "$notification" |
      jq -r '.subject.latest_comment_url // .subject.url // empty')
    detail=$([ -z "$url" ] || gh api "$url" 2>/dev/null || printf '{}')
    jq -nc --argjson notification "$notification" --argjson detail "$detail" \
      '$notification + {$detail}'
  done
}

gh api --paginate notifications -f per_page=100 --method GET |
  jq -sc 'add[]' | enrich | jq -sr '
    def html: tostring | @html;
    def field($name; $value): "&lt;b&gt;\($name):&lt;/b&gt; \($value | html)";
    def metadata: [field("Repository"; .repository.full_name), field("Type"; .subject.type),
      field("Reason"; .reason), field("Author"; (.detail.user.login // .detail.commit.author.name // "unknown"))]
      | join("&lt;br&gt;");
    def body: (.detail.body // .detail.commit.message // "No additional details available.")
      | html | gsub("\\r?\\n"; "&lt;br&gt;");
    def link: (.subject.url // "https://github.com/notifications")
      | sub("^https://api\\.github\\.com/repos/"; "https://github.com/")
      | sub("/pulls/"; "/pull/") | sub("/commits/"; "/commit/");
    "<?xml version=\"1.0\"?><rss version=\"2.0\"><channel><title>GitHub Notifications</title><link>https://github.com/notifications</link><description>Unread GitHub notifications</description>",
    (.[] | "<item><title>[\(.repository.full_name|html)] \(.subject.title|html)</title><link>\(link|html)</link><guid isPermaLink=\"false\">\(.id|html)</guid><pubDate>\(.updated_at|fromdateiso8601|strftime("%a, %d %b %Y %H:%M:%S +0000"))</pubDate><description>\(metadata)&lt;br&gt;&lt;br&gt;\(body)</description></item>"),
    "</channel></rss>"
  '
